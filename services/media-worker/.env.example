MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB=home4you
REDIS_URL=redis://redis:6379

AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=

# Google Cloud Vision (server-side credentials only)
GOOGLE_VISION_API_KEY=

# Bounded concurrency — start small; image decoders can allocate far more
# than the compressed upload size suggests.
MAX_CONCURRENT_JOBS=2

# Lease / retry tuning
LEASE_SECONDS=300
RETRY_BACKOFF_BASE_SECONDS=30
RETRY_BACKOFF_MAX_SECONDS=3600

SCRATCH_DIR=/tmp/media-worker
